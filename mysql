/* ============================================================
    MySQL - Tạo bảng theo ERD (11 bảng)
    ============================================================ */

-- CREATE DATABASE IF NOT EXISTS final_face CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
-- USE final_face;

/* ---------- (Tùy chọn) Xóa bảng cũ để tạo lại, bỏ comment nếu cần ---------- */
SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS camera_count_logs;
DROP TABLE IF EXISTS camera_schedules;
DROP TABLE IF EXISTS camera_logs;
DROP TABLE IF EXISTS violation_types;
DROP TABLE IF EXISTS sensor_logs;
DROP TABLE IF EXISTS device_mcu;
DROP TABLE IF EXISTS person_face_embeddings;
DROP TABLE IF EXISTS persons;
DROP TABLE IF EXISTS camera_device_details;
DROP TABLE IF EXISTS camera_devices;
DROP TABLE IF EXISTS users;
SET FOREIGN_KEY_CHECKS = 1;


/* 1. users */
CREATE TABLE users (
    id             BIGINT AUTO_INCREMENT NOT NULL,
    username       VARCHAR(50)    NOT NULL,
    password_hash  VARCHAR(255)   NOT NULL,
    full_name      VARCHAR(100)   NULL,
    email          VARCHAR(255)   NULL,
    phone          VARCHAR(20)    NULL,
    avatar_url     VARCHAR(500)   NULL,
    role           VARCHAR(20)    NOT NULL DEFAULT 'user',
    token_tele     VARCHAR(255)   NULL,
    id_chat_tele   VARCHAR(100)   NULL,
    is_active      BOOLEAN        NOT NULL DEFAULT 1,
    created_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_users PRIMARY KEY (id),
    CONSTRAINT UQ_users_username UNIQUE (username),
    CONSTRAINT UQ_users_email UNIQUE (email),
    CONSTRAINT CK_users_role CHECK (role IN ('admin', 'user'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;




/* 2. camera_devices */
CREATE TABLE camera_devices (
    id             BIGINT AUTO_INCREMENT NOT NULL,
    camera_code    VARCHAR(50)    NOT NULL,
    user_id        BIGINT         NOT NULL,
    camera_name    VARCHAR(100)   NOT NULL,
    ip_address     VARCHAR(45)    NULL,
    stream_url     VARCHAR(500)   NULL,
    location       VARCHAR(255)   NULL,
    status         VARCHAR(20)    NOT NULL DEFAULT 'offline',
    last_seen      DATETIME       NULL,
    created_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_camera_devices PRIMARY KEY (id),
    CONSTRAINT UQ_camera_devices_code UNIQUE (camera_code),
    CONSTRAINT FK_camera_devices_user FOREIGN KEY (user_id) REFERENCES users(id),
    CONSTRAINT CK_camera_devices_status CHECK (status IN ('online', 'offline'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_camera_devices_user ON camera_devices(user_id);


/* 3. camera_device_details (1-1 với camera_devices) */
CREATE TABLE camera_device_details (
    id                 BIGINT AUTO_INCREMENT NOT NULL,
    camera_id          BIGINT         NOT NULL,
    description        VARCHAR(500)   NULL,
    installation_date  DATE           NULL,
    direction          VARCHAR(100)   NULL,
    created_at         DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at         DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_camera_device_details PRIMARY KEY (id),
    CONSTRAINT UQ_camera_device_details_camera UNIQUE (camera_id),
    CONSTRAINT FK_camera_device_details_camera FOREIGN KEY (camera_id)
        REFERENCES camera_devices(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


/* 4. persons */
CREATE TABLE persons (
    id             BIGINT AUTO_INCREMENT NOT NULL,
    person_code    VARCHAR(50)    NOT NULL,
    full_name      VARCHAR(100)   NOT NULL,
    class_name     VARCHAR(30)    NULL,
    description    VARCHAR(500)   NULL,
    is_active      BOOLEAN        NOT NULL DEFAULT 1,
    created_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_persons PRIMARY KEY (id),
    CONSTRAINT UQ_persons_code UNIQUE (person_code)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
ALTER TABLE persons CHANGE class_name location VARCHAR(255);
ALTER TABLE persons ADD COLUMN user_id BIGINT NULL; ALTER TABLE persons ADD CONSTRAINT FK_persons_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE SET NULL;

/* 5. person_face_embeddings */
CREATE TABLE person_face_embeddings (
    id                 BIGINT AUTO_INCREMENT NOT NULL,
    person_id          BIGINT         NOT NULL,
    model_name         VARCHAR(100)   NOT NULL,
    model_version      VARCHAR(50)    NULL,
    embedding_json     LONGTEXT       NOT NULL,
    sample_image_url   VARCHAR(500)   NULL,
    created_at         DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_person_face_embeddings PRIMARY KEY (id),
    CONSTRAINT FK_emb_person FOREIGN KEY (person_id)
        REFERENCES persons(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_emb_person ON person_face_embeddings(person_id);

ALTER TABLE db_camera.person_face_embeddings 
ADD CONSTRAINT uk_person_id UNIQUE (person_id);
/* 6. device_mcu */
CREATE TABLE device_mcu (
    id             BIGINT AUTO_INCREMENT NOT NULL,
    mac_address    VARCHAR(17)    NOT NULL,
    user_id        BIGINT         NOT NULL,
    device_name    VARCHAR(100)   NOT NULL,
    location       VARCHAR(255)   NULL,
    status         VARCHAR(20)    NOT NULL DEFAULT 'offline',
    last_seen      DATETIME       NULL,
    created_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_device_mcu PRIMARY KEY (id),
    CONSTRAINT UQ_device_mcu_mac UNIQUE (mac_address),
    CONSTRAINT FK_device_mcu_user FOREIGN KEY (user_id) REFERENCES users(id),
    CONSTRAINT CK_device_mcu_status CHECK (status IN ('online', 'offline'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_device_mcu_user ON device_mcu(user_id);


/* 7. sensor_logs */
CREATE TABLE sensor_logs (
    id             BIGINT AUTO_INCREMENT NOT NULL,
    mcu_id         BIGINT         NOT NULL,
    temperature    DECIMAL(6,2)   NULL,
    humidity       DECIMAL(6,2)   NULL,
    gas_level      DECIMAL(6,2)   NULL,
    smoke_level    DECIMAL(6,2)   NULL,
    recorded_at    DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_sensor_logs PRIMARY KEY (id),
    CONSTRAINT FK_sensor_logs_mcu FOREIGN KEY (mcu_id)
        REFERENCES device_mcu(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_sensor_mcu_time ON sensor_logs(mcu_id, recorded_at DESC);


/* 8. violation_types */
CREATE TABLE violation_types (
    id             INT AUTO_INCREMENT NOT NULL,
    code           VARCHAR(50)    NOT NULL,
    name           VARCHAR(100)   NOT NULL,
    description    VARCHAR(500)   NULL,
    is_active      BOOLEAN        NOT NULL DEFAULT 1,
    created_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_violation_types PRIMARY KEY (id),
    CONSTRAINT UQ_violation_types_code UNIQUE (code)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;


/* 9. camera_logs */
CREATE TABLE camera_logs (
    id                   BIGINT AUTO_INCREMENT NOT NULL,
    camera_id            BIGINT         NOT NULL,
    person_id            BIGINT         NULL,      -- NULL = người lạ / chưa nhận diện
    violation_type_id    INT            NOT NULL,
    detected_at          DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    confidence           DECIMAL(5,4)   NULL,
    image_url            VARCHAR(500)   NULL,
    review_status        VARCHAR(20)    NOT NULL DEFAULT 'pending',
    reviewed_by          BIGINT         NULL,
    reviewed_at          DATETIME       NULL,
    review_note          VARCHAR(500)   NULL,
    source_event_id      VARCHAR(100)   NULL,
    created_at           DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_camera_logs PRIMARY KEY (id),
    CONSTRAINT UQ_camlog_source_event UNIQUE (source_event_id),
    CONSTRAINT FK_camlog_camera FOREIGN KEY (camera_id) REFERENCES camera_devices(id),
    CONSTRAINT FK_camlog_person FOREIGN KEY (person_id) REFERENCES persons(id) ON DELETE SET NULL,
    CONSTRAINT FK_camlog_violation FOREIGN KEY (violation_type_id) REFERENCES violation_types(id),
    CONSTRAINT FK_camlog_reviewer FOREIGN KEY (reviewed_by) REFERENCES users(id) ON DELETE SET NULL,
    CONSTRAINT CK_camlog_review CHECK (review_status IN ('pending', 'approved', 'rejected')),
    CONSTRAINT CK_camlog_conf CHECK (confidence IS NULL OR (confidence >= 0 AND confidence <= 1))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_camlog_cam_time ON camera_logs(camera_id, detected_at DESC);
CREATE INDEX IX_camlog_review ON camera_logs(review_status, detected_at DESC);
CREATE INDEX IX_camlog_person ON camera_logs(person_id);
CREATE INDEX IX_camlog_violation ON camera_logs(violation_type_id);


/* 10. camera_schedules */
CREATE TABLE camera_schedules (
    id               BIGINT AUTO_INCREMENT NOT NULL,
    camera_id        BIGINT         NOT NULL,
    schedule_name    VARCHAR(100)   NOT NULL,
    start_time       TIME           NOT NULL,
    end_time         TIME           NOT NULL,
    days_of_week     VARCHAR(30)    NOT NULL,   -- ví dụ '1,2,3,4,5' (1 = Thứ 2 ... 7 = CN)
    is_active        BOOLEAN        NOT NULL DEFAULT 1,
    created_at       DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at       DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_camera_schedules PRIMARY KEY (id),
    CONSTRAINT FK_sched_camera FOREIGN KEY (camera_id)
        REFERENCES camera_devices(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_sched_camera ON camera_schedules(camera_id);


/* 11. camera_count_logs */
CREATE TABLE camera_count_logs (
    id              BIGINT AUTO_INCREMENT NOT NULL,
    camera_id       BIGINT         NOT NULL,
    person_count    INT            NOT NULL,
    recorded_at     DATETIME       NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_camera_count_logs PRIMARY KEY (id),
    CONSTRAINT FK_count_camera FOREIGN KEY (camera_id)
        REFERENCES camera_devices(id) ON DELETE CASCADE,
    CONSTRAINT CK_count_nonneg CHECK (person_count >= 0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE INDEX IX_count_cam_time ON camera_count_logs(camera_id, recorded_at DESC);

