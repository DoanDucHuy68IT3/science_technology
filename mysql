/* ============================================================
   Giáo viên quản lý học sinh
   ============================================================ */
SELECT u.username, COUNT(p.id) AS so_hoc_sinh
FROM users u
LEFT JOIN persons p ON p.user_id = u.id
WHERE u.id BETWEEN 101 AND 110
GROUP BY u.id, u.username
ORDER BY u.id;

/* ============================================================
   Giáo viên quản lý camera
   ============================================================ */
SELECT u.id AS user_id, u.username, u.full_name,
       c.id AS camera_id, c.camera_code, c.camera_name, c.location, c.status
FROM users u
JOIN camera_devices c ON c.user_id = u.id
WHERE u.id BETWEEN 101 AND 110
ORDER BY u.id, c.id;

/* ============================================================
   Camera quản lý học sinh
   ============================================================ *
SELECT c.camera_code, c.location, c.status,
       p.person_code, p.full_name
FROM camera_devices c
LEFT JOIN persons p ON p.location = c.location
WHERE c.id BETWEEN 101 AND 110
ORDER BY c.id, p.id;

/* ============================================================
   giáo viên quản lý học sinh qua camera
   ============================================================ *
SELECT DISTINCT u.username, p.person_code, p.full_name, p.location
FROM users u
JOIN camera_devices c ON c.user_id = u.id
JOIN persons p ON p.location = c.location
WHERE u.id BETWEEN 101 AND 110
ORDER BY u.username, p.person_code;

