CREATE TABLE user_health (
    id INT IDENTITY(1,1) PRIMARY KEY,
    user_id INT NOT NULL,

    gender NVARCHAR(20) NULL,
    age INT NULL,
    hypertension BIT DEFAULT 0,
    heart_disease BIT DEFAULT 0,
    smoking_history NVARCHAR(50) NULL,

    bmi_score FLOAT NULL,
    haemoglobin_level FLOAT NULL,
    blood_glucose_level FLOAT NULL,

    is_diabetic BIT DEFAULT 0,

    create_day DATETIME2 DEFAULT GETDATE(),
    update_day DATETIME2 NULL,

    CONSTRAINT FK_user_health_users
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
);
