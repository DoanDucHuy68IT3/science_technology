use khkt_iot

CREATE TABLE users (
    id INT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(100) NOT NULL,
    password NVARCHAR(255) NOT NULL,
    email NVARCHAR(100) UNIQUE NOT NULL,
    create_day DATETIME DEFAULT GETDATE(),
    update_day DATETIME NULL,
    avatar NVARCHAR(MAX) NULL
);
CREATE TABLE faces (
    id INT IDENTITY(1,1) PRIMARY KEY,
    user_id INT NOT NULL,
    face NVARCHAR(MAX) NOT NULL,
    create_day DATETIME DEFAULT GETDATE(),

    CONSTRAINT FK_faces_users
        FOREIGN KEY (user_id) REFERENCES users(id)
);


CREATE TABLE devices_mcu (
    mcu_id VARCHAR(100) PRIMARY KEY,
    user_id INT NOT NULL,
    create_day DATETIME2 DEFAULT GETDATE(),
    update_day DATETIME2 NULL,
    location NVARCHAR(255) NULL,
    status BIT NOT NULL DEFAULT 1,

    CONSTRAINT FK_devices_mcu_users
        FOREIGN KEY (user_id)
        REFERENCES users(id)
);
CREATE TABLE devices_camera (
    camera_id NVARCHAR(50) PRIMARY KEY,
    user_id INT NULL,
    create_day DATETIME DEFAULT GETDATE(),
    update_day DATETIME NULL,
    location NVARCHAR(255) NULL,
    status INT DEFAULT 1,

    CONSTRAINT FK_devices_camera_users
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE SET NULL
);
CREATE TABLE sensor_logs (
    id INT IDENTITY(1,1) PRIMARY KEY,
    mcu_id VARCHAR(100) NOT NULL,
    temperature FLOAT NULL,
    humidity FLOAT NULL,
    heart INT NULL,
    time DATETIME DEFAULT GETDATE(),

    CONSTRAINT FK_sensor_logs_devices_mcu
        FOREIGN KEY (mcu_id)
        REFERENCES devices_mcu(mcu_id)
);

CREATE TABLE person_count_logs (
    id INT IDENTITY(1,1) PRIMARY KEY,
    camera_id NVARCHAR(50) NOT NULL,
    number INT NOT NULL,
    time DATETIME DEFAULT GETDATE(),

    CONSTRAINT FK_person_count_logs_camera
        FOREIGN KEY (camera_id)
        REFERENCES devices_camera(camera_id)
);
CREATE TABLE detect_person_logs (
    id INT IDENTITY(1,1) PRIMARY KEY,

    camera_id NVARCHAR(50) NOT NULL,
    user_id INT NOT NULL,

    image NVARCHAR(MAX) NULL,
    time DATETIME DEFAULT GETDATE(),

    CONSTRAINT FK_detect_person_logs_camera
        FOREIGN KEY (camera_id)
        REFERENCES devices_camera(camera_id),

    CONSTRAINT FK_detect_person_logs_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE
);

